{
  "name": "trs-jack-3d",
  "private": true,
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "artifacts": "vite-node scripts/generateArtifacts.ts",
    "sensitivity": "vite-node scripts/sensitivity.ts",
    "sensitivity:events": "vite-node scripts/sensitivityEvents.ts",
    "sensitivity:events:all": "npm run sensitivity:events -- --variant \"TRS|JACK-TRS\" && npm run sensitivity:events -- --variant \"TRS|JACK-TRRS\"",
    "inspect": "vite-node scripts/inspect.ts",
    "typecheck": "tsc -b",
    "screenshots": "node scripts/screenshots.mjs",
    "docs:html": "node scripts/mdToHtml.mjs",
    "test:count": "node scripts/testCount.mjs",
    "check:stale": "vite-node scripts/checkStale.ts",
    "check:vacuity": "node scripts/checkVacuity.mjs",
    "validate:profiles": "node scripts/validateProfiles.mjs",
    "release:evidence": "node scripts/buildReleaseEvidence.mjs",
    "release:snapshot": "node scripts/buildSourceSnapshot.mjs",
    "release:stage": "node scripts/stageRelease.mjs",
    "verify:provenance": "node scripts/verifyProvenance.mjs",
    "verify:release-source-inputs": "node scripts/verifyReleaseSourceInputs.mjs",
    "artifacts:all": "npm run artifacts && npm run export:half-plug:all && npm run compare:real-jack && npm run test:count",
    "perf": "node scripts/perf.mjs",
    "touch": "node scripts/touch.mjs",
    "predict:probe": "vite-node scripts/predictProbe.ts",
    "fit:contacts": "vite-node scripts/fitContacts.ts",
    "export:half-plug": "vite-node scripts/exportHalfPlugProfile.ts",
    "search:topology": "vite-node scripts/searchTopology.ts",
    "search:robustness": "vite-node scripts/searchTopologyRobustness.ts",
    "compare:real-jack": "vite-node scripts/compareRealJack.ts",
    "export:half-plug:all": "npm run export:half-plug -- --variant \"TRS|JACK-TRS\" && npm run export:half-plug -- --variant \"TRS|JACK-TRRS\""
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.20.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.62.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
