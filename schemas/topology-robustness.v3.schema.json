{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://github.com/Driedsandwich/trs-jack-3d/schemas/topology-robustness.v3.schema.json",
 "title": "trs-jack-3d target topology robustness v3",
 "description": "目標トポロジーが**そもそも存在するか**と、**区間幅がどれだけ残るか**を、存否を反転させうる仮定を同時に振って測ったもの。**イベント深さの幅 (event-sensitivity) とは別の量である。**2026-08-03 の非阻害フォローアップオーダー P1-4 で新設。**v2 は v1 と非互換。**窓の端点を startMm / lastSampleMm / endExclusiveMm に分けた。v1 の `toMm` は最後に当たった標本位置であって区間の終端ではなく、profile の nominalEndMm と食い違って見えた",
 "type": "object",
 "required": [
  "schemaVersion",
  "contractMigration",
  "windowEndConvention",
  "variantId",
  "targetTopologyClass",
  "basis",
  "generatedFromCommit",
  "provenance",
  "sweptParameters",
  "parameterRanges",
  "searchRangeBasis",
  "configurationsTotal",
  "configurationsUsable",
  "configurationsWithTarget",
  "presenceFractionWithinConstructedSweep",
  "intervalWidthMm",
  "presenceByLevel",
  "nominalConfiguration",
  "necessaryConditions",
  "counterExamples",
  "counterExampleSampling",
  "sourceEvidenceBoundary",
  "physicalProbabilityClaim",
  "empiricalEvidence",
  "notes"
 ],
 "additionalProperties": false,
 "properties": {
  "schemaVersion": {
   "const": 3
  },
  "generatedBy": {
   "type": "string"
  },
  "generatedAt": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "variantId": {
   "type": "string"
  },
  "targetTopologyClass": {
   "type": "string",
   "description": "存否を調べた対象のクラス。src/model/topology.ts の語彙"
  },
  "basis": {
   "const": "MODEL_PARAMETER_SWEEP",
   "description": "**実測ではない。**モデルのパラメータを振った結果であることを機械可読にする"
  },
  "generatedFromCommit": {
   "type": "string",
   "pattern": "^([0-9a-f]{40}|UNKNOWN)$"
  },
  "provenance": {
   "type": "object",
   "description": "何から作られたか。**`generatedFromCommit` ではなく `inputDigest` で固定してください。** artifact を含めてコミットすると HEAD は変わりますが、入力は変わっていないので `inputDigest` は変わりません",
   "required": [
    "generatorVersion",
    "generatedFromCommit",
    "workingTreeDirty",
    "revisionOverride",
    "artifactKind",
    "inputDigestAlgorithm",
    "inputDigest",
    "inputDigestScope",
    "inputFiles",
    "command",
    "artifactDate"
   ],
   "additionalProperties": false,
   "properties": {
    "generatorVersion": {
     "type": "integer",
     "minimum": 1,
     "description": "生成器の版。出力の形を変えたときだけ上がる。データが変わっただけでは上がらない (それは inputDigest が表す)"
    },
    "generatedFromCommit": {
     "type": "string",
     "pattern": "^([0-9a-f]{40}|UNKNOWN)$",
     "description": "生成時点の HEAD。**参考値。** 一致を要求してはならない"
    },
    "workingTreeDirty": {
     "type": "boolean",
     "description": "**入力ファイルに**未コミットの変更があったか。true の artifact は release asset にできない。artifact 自身の変更は見ない"
    },
    "revisionOverride": {
     "type": "boolean",
     "description": "SOURCE_REVISION による上書きが使われたか。通常モードでは常に false"
    },
    "artifactKind": {
     "enum": [
      "local",
      "release"
     ],
     "description": "local = 手元で生成 (リポジトリにコミットされているものはこちら)。release = clean な入力から --release で生成した配布物"
    },
    "inputDigestAlgorithm": {
     "const": "sha256"
    },
    "inputDigest": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "inputDigestScope": {
     "type": "string",
     "description": "digest の作り方。第三者が同じ値を再計算できるように書く"
    },
    "inputFiles": {
     "type": "array",
     "minItems": 1,
     "description": "digest の対象。**生成される artifact 自身は含まない** (含めると自己参照になる)",
     "items": {
      "type": "object",
      "required": [
       "path",
       "sha256",
       "role"
      ],
      "additionalProperties": false,
      "properties": {
       "path": {
        "type": "string"
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "role": {
        "enum": [
         "schema",
         "generator",
         "model-data",
         "model-code",
         "lockfile",
         "sensitivity-input",
         "input-scope",
         "contract-migration"
        ],
        "description": "**`input-scope` は入力の範囲定義 (source-input-scope.v1.json)。v0.3.0 フォローアップ P1-2 で追加。**"
       }
      }
     }
    },
    "command": {
     "type": "string",
     "description": "再生成に使うコマンド。呼び出し経路によらない正規形"
    },
    "artifactDate": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "description": "**UTC の日付**（`toISOString()` 由来）。生成した人の現地時刻より 1 日手前になることがある。commit の日付と 1 日ずれていても陳腐化ではない。ARTIFACT_DATE で固定できる"
    },
    "inputSettings": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     },
     "description": "digest に混ぜたファイル以外の入力 (variant 固有の走査設定など)。**値そのものを記録する。** 記録しないと第三者が inputDigest を再計算できない。この項目が無い artifact は setting 行を使っていない"
    }
   }
  },
  "stepMm": {
   "type": "number",
   "exclusiveMinimum": 0
  },
  "sweptParameters": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   },
   "description": "実際に振った軸。**単独キーで動かない概念は複合軸として実装する** (parameterRanges[].compound)"
  },
  "parameterRanges": {
   "type": "object",
   "minProperties": 1,
   "additionalProperties": {
    "type": "object",
    "required": [
     "keys",
     "levels",
     "shipped",
     "unit",
     "meaning",
     "compound"
    ],
    "additionalProperties": false,
    "properties": {
     "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      },
      "description": "この軸が実際に書き換える寸法キー"
     },
     "levels": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "number"
      }
     },
     "shipped": {
      "type": "number",
      "description": "**必ず levels に含まれること。**無改造の構成を評価し損なわないため"
     },
     "unit": {
      "type": "string"
     },
     "meaning": {
      "type": "string"
     },
     "compound": {
      "type": "boolean",
      "description": "複数キーを連動させる軸か。beamOffset のように、単独キーの上書きでは 1mm も動かない概念がある"
     }
    }
   }
  },
  "searchRangeBasis": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   },
   "description": "**走査範囲の根拠と任意性を明示する。**広げれば割合は下がり、狭めれば上がる"
  },
  "configurationsTotal": {
   "type": "integer",
   "minimum": 1
  },
  "configurationsUsable": {
   "type": "integer",
   "minimum": 1,
   "description": "組めて、かつ完全挿入が成立した構成の数"
  },
  "configurationsWithTarget": {
   "type": "integer",
   "minimum": 0,
   "description": "**0 でも正常な結果である。**「探したが無かった」は「探していない」とは違う"
  },
  "configurationsBuildFailed": {
   "type": "integer",
   "minimum": 0
  },
  "configurationsFullInsertionNotOk": {
   "type": "integer",
   "minimum": 0
  },
  "presenceFractionWithinConstructedSweep": {
   "type": "number",
   "minimum": 0,
   "maximum": 1,
   "description": "**実物で起きる確率ではない。**この構成空間の中で目標が現れた割合にすぎず、走査範囲の取り方は任意である"
  },
  "intervalWidthMm": {
   "type": "object",
   "required": [
    "min",
    "median",
    "max"
   ],
   "additionalProperties": false,
   "properties": {
    "min": {
     "type": [
      "number",
      "null"
     ]
    },
    "median": {
     "type": [
      "number",
      "null"
     ]
    },
    "max": {
     "type": [
      "number",
      "null"
     ]
    }
   },
   "description": "目標が現れた構成での区間幅。目標 0 件なら 3 つとも null"
  },
  "presenceByLevel": {
   "type": "object",
   "minProperties": 1,
   "description": "水準ごとの内訳。**necessaryConditions が 0 件でも、効いている軸はここに出る**",
   "additionalProperties": {
    "type": "array",
    "minItems": 2,
    "items": {
     "type": "object",
     "required": [
      "level",
      "isShipped",
      "configurationsUsable",
      "configurationsWithTarget",
      "presenceFraction",
      "medianIntervalWidthMm"
     ],
     "additionalProperties": false,
     "properties": {
      "level": {
       "type": "number"
      },
      "isShipped": {
       "type": "boolean"
      },
      "configurationsUsable": {
       "type": "integer",
       "minimum": 0
      },
      "configurationsWithTarget": {
       "type": "integer",
       "minimum": 0
      },
      "presenceFraction": {
       "type": [
        "number",
        "null"
       ],
       "minimum": 0,
       "maximum": 1
      },
      "medianIntervalWidthMm": {
       "type": [
        "number",
        "null"
       ]
      }
     }
    }
   }
  },
  "nominalConfiguration": {
   "type": "object",
   "required": [
    "label",
    "targetPresent",
    "windows",
    "note"
   ],
   "additionalProperties": false,
   "properties": {
    "label": {
     "type": "string"
    },
    "targetPresent": {
     "type": "boolean"
    },
    "windows": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/window"
     }
    },
    "note": {
     "type": "string",
     "description": "**「市販品でそうなる」ではない。**入力値を 1 つも変えていない、というだけ"
    }
   }
  },
  "necessaryConditions": {
   "type": "array",
   "description": "その水準では他をどう組み合わせても目標が現れない、という条件。**0 件は「どの軸も効かない」という意味ではない** (presenceByLevel を見ること)",
   "items": {
    "type": "object",
    "required": [
     "parameter",
     "unit",
     "levelsWhereTargetNeverAppears",
     "levelsTested",
     "statement",
     "boundaryResolved"
    ],
    "additionalProperties": false,
    "properties": {
     "parameter": {
      "type": "string"
     },
     "unit": {
      "type": "string"
     },
     "levelsWhereTargetNeverAppears": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "number"
      }
     },
     "levelsTested": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "number"
      }
     },
     "statement": {
      "type": "string"
     },
     "boundaryResolved": {
      "const": false,
      "description": "走査した水準の中での話であり、連続的な境界を求めたものではない"
     }
    }
   }
  },
  "counterExamples": {
   "type": "array",
   "minItems": 1,
   "description": "目標が現れない構成。**実在部品の一次資料 (PS000001) を必ず含める**",
   "items": {
    "type": "object",
    "required": [
     "kind",
     "label",
     "overrides",
     "targetPresent",
     "windows",
     "fullInsertionOk",
     "note"
    ],
    "additionalProperties": false,
    "properties": {
     "kind": {
      "enum": [
       "REAL_PART_DRAWING",
       "MODEL_SWEEP_ABSENT"
      ],
      "description": "REAL_PART_DRAWING は実在部品の図面値で、構成した仮定より重い"
     },
     "label": {
      "type": "string"
     },
     "overrides": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      }
     },
     "targetPresent": {
      "type": "boolean"
     },
     "windows": {
      "type": "array",
      "items": {
       "$ref": "#/definitions/window"
      }
     },
     "fullInsertionOk": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    }
   }
  },
  "counterExampleSampling": {
   "type": "object",
   "required": [
    "absentConfigurationsTotal",
    "modelSweepSamplesListed",
    "omitted",
    "note"
   ],
   "additionalProperties": false,
   "description": "**黙って切らない。**何件を載せ、何件を落としたかを書く",
   "properties": {
    "absentConfigurationsTotal": {
     "type": "integer",
     "minimum": 0
    },
    "modelSweepSamplesListed": {
     "type": "integer",
     "minimum": 0
    },
    "omitted": {
     "type": "integer",
     "minimum": 0
    },
    "note": {
     "type": "string"
    }
   }
  },
  "sourceEvidenceBoundary": {
   "type": "object",
   "required": [
    "fact",
    "assumption",
    "notMeasured"
   ],
   "additionalProperties": false,
   "description": "どこまでが図面の記載値で、どこからが仮定か",
   "properties": {
    "fact": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "assumption": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    },
    "notMeasured": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string"
     }
    }
   }
  },
  "physicalProbabilityClaim": {
   "const": false,
   "description": "**この artifact は実物で起きる確率を主張しない。**下流が読み違えないよう artifact 自身に持たせる"
  },
  "empiricalEvidence": {
   "type": [
    "object",
    "null"
   ],
   "description": "実物の導通測定。**model sweep と同じ項目に混ぜない。**未実施の間は null"
  },
  "notes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  },
  "windowEndConvention": {
   "const": "EXCLUSIVE",
   "description": "`endExclusiveMm` は含まない側の端。profile の `nominalEndMm` と一致する"
  },
  "contractMigration": {
   "type": "object",
   "description": "**版と契約変更の対応表。**旧語彙を読む消費側が沈黙ではなくエラーになるためのもの。判定は docs/SCHEMA_VERSIONING_POLICY.md の条文（新 schema が許す言語が旧 schema の言語に収まるか）による。**artifact の中身では判定しない**——同じ変更でも、その版の artifact が新しい値を使っているかで答えが反転してしまうため。正本は contract-migration.v1.json",
   "required": [
    "schemaId",
    "previousSchemaId",
    "fromSchemaVersion",
    "toSchemaVersion",
    "breaking",
    "policy",
    "consumerAction",
    "renamedAssets",
    "history"
   ],
   "additionalProperties": false,
   "properties": {
    "schemaId": {
     "const": "topology-robustness.v3"
    },
    "previousSchemaId": {
     "const": "topology-robustness.v2"
    },
    "fromSchemaVersion": {
     "const": 2
    },
    "toSchemaVersion": {
     "const": 3
    },
    "breaking": {
     "const": true
    },
    "policy": {
     "type": "object",
     "required": [
      "document",
      "policyVersion",
      "decisionRule"
     ],
     "additionalProperties": false,
     "properties": {
      "document": {
       "const": "docs/SCHEMA_VERSIONING_POLICY.md"
      },
      "policyVersion": {
       "type": "integer",
       "minimum": 1
      },
      "decisionRule": {
       "const": "language-subset"
      },
      "note": {
       "type": "string"
      }
     }
    },
    "consumerAction": {
     "type": "string",
     "minLength": 1
    },
    "renamedAssets": {
     "type": "array",
     "minItems": 1,
     "description": "**条文の外（第6条）。**配布名は schema の言語に現れないので、名前で引く下流は schema 検査に到達する前に「ファイルが無い」で止まる",
     "items": {
      "type": "object",
      "required": [
       "from",
       "to",
       "reason"
      ],
      "additionalProperties": false,
      "properties": {
       "from": {
        "type": "string"
       },
       "to": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      }
     }
    },
    "history": {
     "type": "array",
     "minItems": 1,
     "description": "**契約が変わった release を古い順に並べる。**版を据え置いたまま変えた回は versionWasHeld: true で残す。それが条文違反の記録である",
     "items": {
      "type": "object",
      "required": [
       "shippedIn",
       "previousRelease",
       "previousSchemaPath",
       "currentSchemaPath",
       "schemaVersionAtTheTime",
       "versionWasHeld",
       "policyVerdict",
       "changes"
      ],
      "additionalProperties": false,
      "properties": {
       "shippedIn": {
        "type": "string",
        "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
       },
       "previousRelease": {
        "type": "string",
        "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
       },
       "previousSchemaPath": {
        "type": "string",
        "description": "**previousRelease 時点でのこの schema のパス。**版を上げるとファイル名が変わるので、記録側に持たせないと機械で突き合わせられない"
       },
       "currentSchemaPath": {
        "type": "string"
       },
       "schemaVersionAtTheTime": {
        "type": "integer",
        "minimum": 1
       },
       "schemaVersionShouldHaveBeen": {
        "type": "integer",
        "minimum": 1,
        "description": "据え置いた回にだけ入る。**条文に照らして本来あるべきだった版**"
       },
       "versionWasHeld": {
        "type": "boolean"
       },
       "policyVerdict": {
        "enum": [
         "BUMP",
         "HOLD_RECORD",
         "HOLD"
        ]
       },
       "recordedRetroactivelyIn": {
        "type": "string",
        "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
        "description": "**いつ遡って書いたか。**当時の判断記録ではないことを隠さない"
       },
       "note": {
        "type": "string"
       },
       "changes": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "required": [
          "kind",
          "effect",
          "schemaPointer",
          "reason"
         ],
         "additionalProperties": false,
         "properties": {
          "kind": {
           "enum": [
            "field-added",
            "field-removed",
            "field-renamed",
            "field-reshaped",
            "enum-value-added",
            "enum-value-removed",
            "enum-value-renamed",
            "type-widened",
            "type-narrowed",
            "constraint-tightened",
            "constraint-loosened",
            "const-changed",
            "meaning-changed",
            "description-only"
           ]
          },
          "effect": {
           "enum": [
            "WIDEN",
            "NARROW",
            "NEUTRAL",
            "UNDECIDABLE"
           ],
           "description": "**scripts/schemaLanguageDiff.mjs の判定をそのまま入れる。**記録と実物がずれたらテストが落ちる"
          },
          "schemaPointer": {
           "type": "string",
           "pattern": "^/",
           "description": "**artifact ではなく schema への JSON Pointer。**実在することを機械で確かめる"
          },
          "instancePath": {
           "type": "string",
           "description": "人が読むための位置。$.a.b[].c 形式"
          },
          "added": {
           "type": "array",
           "items": {
            "type": "string"
           }
          },
          "removed": {
           "type": "array",
           "items": {
            "type": "string"
           }
          },
          "from": {
           "type": [
            "string",
            "number",
            "boolean"
           ]
          },
          "to": {
           "type": [
            "string",
            "number",
            "boolean"
           ]
          },
          "reason": {
           "type": "string",
           "minLength": 1
          }
         }
        }
       }
      }
     }
    }
   }
  }
 },
 "definitions": {
  "window": {
   "type": "object",
   "required": [
    "startMm",
    "lastSampleMm",
    "endExclusiveMm",
    "widthMm"
   ],
   "additionalProperties": false,
   "description": "**「終わり」を 2 つに分けてある。**`lastSampleMm` は観測の最後の点、`endExclusiveMm` は区間の終端",
   "properties": {
    "startMm": {
     "type": "number",
     "description": "区間の始まり。profile の nominalStartMm と一致する"
    },
    "lastSampleMm": {
     "type": "number",
     "description": "目標クラスが観測された最後の標本位置。**区間の終端ではない**"
    },
    "endExclusiveMm": {
     "type": "number",
     "description": "lastSampleMm + stepMm。**profile の nominalEndMm と一致する**"
    },
    "widthMm": {
     "type": "number",
     "exclusiveMinimum": 0,
     "description": "endExclusiveMm − startMm"
    }
   }
  }
 }
}
