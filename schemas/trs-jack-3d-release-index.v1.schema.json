{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Driedsandwich/trs-jack-3d/schemas/trs-jack-3d-release-index.v1.schema.json",
  "title": "trs-jack-3d release index v1",
  "description": "release asset の索引。**下流が報告文から値を手で転記しなくて済むようにするためのもの。**v0.2.0 では下流が lock を手入力で作っており、転記ミスの余地があった",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseTag",
    "artifactGenerationCommit",
    "artifactGenerationCommits",
    "profileSchemaVersion",
    "profileSchemaId",
    "profiles",
    "assets",
    "notes",
    "evidenceBuiltAtCommit",
    "releaseCommit"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedBy": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "releaseTag": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "**null なら未 tag。**evidence をコミットしてから tag を打つので、生成時点では知りようがない"
    },
    "releaseCommit": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|UNKNOWN)$"
        },
        {
          "type": "null"
        }
      ],
      "description": "**null なら未 tag。**RELEASE_COMMIT で渡されたときだけ入る"
    },
    "artifactGenerationCommit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|UNKNOWN)$",
      "description": "**profile の生成 commit。**下流の lock が既定で照合する値。全 artifact が同じ commit で生成されるとは限らないので、正確には artifactGenerationCommits を見ること"
    },
    "artifactGenerationCommits": {
      "type": "array",
      "minItems": 1,
      "description": "**生成 commit は 1 つではない。**release 工程が 2 段階のため、profile と感度・頑健性で違う",
      "items": {
        "type": "object",
        "required": [
          "commit",
          "assets"
        ],
        "additionalProperties": false,
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|UNKNOWN)$"
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "profileSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "profileSchemaId": {
      "type": "string"
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "filename",
          "profileId",
          "inputDigest",
          "sha256",
          "generatedFromCommit",
          "sensitivityAsset"
        ],
        "additionalProperties": false,
        "properties": {
          "filename": {
            "type": "string"
          },
          "profileId": {
            "type": "string"
          },
          "inputDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "generatedFromCommit": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|UNKNOWN)$"
          },
          "sensitivityAsset": {
            "type": "object",
            "required": [
              "filename",
              "sha256",
              "inputDigest",
              "generatedFromCommit"
            ],
            "additionalProperties": false,
            "properties": {
              "filename": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "inputDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "generatedFromCommit": {
                "type": "string",
                "pattern": "^([0-9a-f]{40}|UNKNOWN)$"
              }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "filename",
          "sha256",
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "filename": {
            "type": "string",
            "description": "**配布名。契約の一部である。**下流の lock はこれでファイルを引く"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "type": "string"
          },
          "generatedFromCommit": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|UNKNOWN)$",
            "description": "**この asset を生成した commit。asset ごとに違いうる。**release commit と混同しないこと"
          },
          "inputDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "入力の指紋。固定にはこちらを使う"
          },
          "profileId": {
            "type": "string"
          }
        }
      },
      "description": "**この索引自身は含まない**（自己参照になる）。索引の sha256 は SHA256SUMS が持つ"
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidenceBuiltAtCommit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|UNKNOWN)$",
      "description": "この索引を作った時点の HEAD"
    }
  }
}
