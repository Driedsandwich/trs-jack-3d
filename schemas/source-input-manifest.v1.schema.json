{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Driedsandwich/trs-jack-3d/schemas/source-input-manifest.v1.schema.json",
  "title": "trs-jack-3d source input manifest v1",
  "description": "artifact の入力ファイルを tag source と独立に検算するための一覧。**この manifest 自身は証明ではない。**tag source archive を取って自分で計算すること",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "generatedFromCommit",
    "purpose",
    "inputScope",
    "inputFilesTotal",
    "inconsistentAcrossArtifacts",
    "mismatchedWithWorkingTreeAtBuild",
    "inputFiles",
    "verificationRecipe",
    "note"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedBy": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generatedFromCommit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|UNKNOWN)$"
    },
    "purpose": {
      "type": "string"
    },
    "inputScope": {
      "type": "object",
      "description": "**この一覧が「全部」なのかを確かめるための範囲**（v0.3.0 フォローアップ P1-2）。件数と sha256 だけでは記録漏れを見つけられない——落ちている入力があっても、残った分は全部一致する。範囲を渡せば受け手は自分の source を歩いて探せる",
      "additionalProperties": false,
      "required": [
        "file",
        "sha256",
        "recursiveDirectories",
        "requiredExactFiles",
        "allowedGeneratedInputs",
        "excludedOutputs",
        "notCovered",
        "verifyCommand"
      ],
      "properties": {
        "file": {
          "const": "source-input-scope.v1.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recursiveDirectories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "requiredExactFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "allowedGeneratedInputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludedOutputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "notCovered": {
          "type": "array",
          "minItems": 1,
          "description": "**inputDigest が覆っていないもの。**「一致した」は「これらも同じだった」を意味しない",
          "items": {
            "type": "object",
            "required": [
              "what",
              "why",
              "consequence"
            ],
            "properties": {
              "what": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "consequence": {
                "type": "string"
              }
            }
          }
        },
        "verifyCommand": {
          "type": "string"
        }
      }
    },
    "inputFilesTotal": {
      "type": "integer",
      "minimum": 1
    },
    "inconsistentAcrossArtifacts": {
      "type": "integer",
      "minimum": 0,
      "description": "同じパスが artifact 間で違う sha256 で現れた数。**0 でなければどれかが古い入力から作られている**"
    },
    "mismatchedWithWorkingTreeAtBuild": {
      "type": "integer",
      "minimum": 0
    },
    "inputFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "recordedSha256",
          "consistentAcrossArtifacts",
          "actualSha256AtBuild",
          "matchesWorkingTree",
          "consumedBy"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "recordedSha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            ],
            "description": "**配列なら artifact 間で食い違っている。**先勝ちで潰さず両方を残す"
          },
          "consistentAcrossArtifacts": {
            "type": "boolean"
          },
          "actualSha256AtBuild": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "matchesWorkingTree": {
            "type": "boolean"
          },
          "consumedBy": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "verificationRecipe": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": "string"
    }
  }
}
