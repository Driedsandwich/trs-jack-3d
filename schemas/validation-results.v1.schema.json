{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Driedsandwich/trs-jack-3d/schemas/validation-results.v1.schema.json",
  "title": "trs-jack-3d validation results v1",
  "description": "こちらで意味規則が通っているかの記録。**受け手の環境で同じ判定になる保証ではない。**同梱の schema で自分で検証すること",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "generatedFromCommit",
    "command",
    "targetsTotal",
    "targetsPassed",
    "allPassed",
    "distributedTargets",
    "sourceOnlyTargets",
    "results",
    "note"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedBy": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "generatedFromCommit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|UNKNOWN)$"
    },
    "command": {
      "type": "string"
    },
    "targetsTotal": {
      "type": "integer",
      "minimum": 1
    },
    "targetsPassed": {
      "type": "integer",
      "minimum": 0
    },
    "allPassed": {
      "type": "boolean"
    },
    "distributedTargets": {
      "type": "integer",
      "minimum": 0,
      "description": "release asset として配布する検証対象の数"
    },
    "sourceOnlyTargets": {
      "type": "integer",
      "minimum": 0,
      "description": "**配布しない検証対象の数。**受け手は bundle だけでは全対象を再検証できない"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "schema",
          "missing",
          "distribution",
          "schemaErrorCount",
          "semanticErrorCount",
          "schemaErrors",
          "semanticErrors"
        ],
        "additionalProperties": false,
        "properties": {
          "artifact": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          },
          "missing": {
            "type": "boolean"
          },
          "distribution": {
            "enum": [
              "RELEASE_ASSET",
              "SOURCE_ONLY"
            ],
            "description": "**SOURCE_ONLY は bundle に入っていない。**受け手が独立再検証できるのは RELEASE_ASSET だけ"
          },
          "schemaErrorCount": {
            "type": "integer",
            "minimum": 0
          },
          "semanticErrorCount": {
            "type": "integer",
            "minimum": 0
          },
          "schemaErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "semanticErrors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "note": {
      "type": "string"
    }
  }
}
