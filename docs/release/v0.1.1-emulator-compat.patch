+    if (!['MEASURED','MODEL_SWEEP_EVENT_SPECIFIC'].includes(event.spreadStatus) || event.spreadMm === null) continue;
     const { minMm, maxMm } = event.spreadMm;
     if (!(Number.isFinite(minMm) && Number.isFinite(maxMm) && minMm <= event.depthMm && event.depthMm <= maxMm)) {
       if (!issueCodes.includes('SENSITIVITY_NOMINAL_OUTSIDE_EVENT_RANGE')) issueCodes.push('SENSITIVITY_NOMINAL_OUTSIDE_EVENT_RANGE');
@@ -115,7 +115,7 @@
     summary: {
